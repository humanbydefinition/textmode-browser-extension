{
	"name": "textmode-ascii-overlay-extension",
	"version": "1.2.0",
	"description": "Browser extension for overlaying real-time textmode.js ASCII conversion on page canvas and video elements.",
	"type": "module",
	"license": "MIT",
	"author": "humanbydefinition <hello@textmode.art> (https://code.textmode.art)",
	"homepage": "https://code.textmode.art",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/humanbydefinition/textmode-browser-extensions.git"
	},
	"bugs": {
		"url": "https://github.com/humanbydefinition/textmode-browser-extensions/issues"
	},
	"keywords": [
		"ascii-art",
		"browser-extension",
		"chrome-extension",
		"creative-coding",
		"textmode",
		"textmode-js",
		"wxt"
	],
	"engines": {
		"node": ">=20.8.1"
	},
	"scripts": {
		"postinstall": "wxt prepare",
		"build": "wxt build",
		"build:chrome": "wxt build -b chrome --mv3",
		"build:e2e:chrome": "wxt build -b chrome --mv3 --mode e2e",
		"build:opera": "wxt build -b chrome --mv3 --mode opera",
		"build:edge": "wxt build -b edge --mv3",
		"build:firefox": "wxt build -b firefox --mv3",
		"build:safari": "wxt build -b safari",
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox --mv3",
		"zip": "wxt zip",
		"zip:chrome": "wxt zip -b chrome --mv3",
		"zip:opera": "wxt zip -b chrome --mv3 --mode opera && mv .output/textmode-ascii-overlay-extension-$npm_package_version-chrome.zip .output/textmode-ascii-overlay-extension-$npm_package_version-opera.zip",
		"zip:edge": "wxt zip -b edge --mv3",
		"zip:firefox": "wxt zip -b firefox --mv3",
		"lint:firefox": "npm run build:firefox && web-ext lint --source-dir .output/firefox-mv3 --self-hosted",
		"test": "textmode-build test",
		"test:watch": "textmode-build test:watch",
		"typecheck": "tsc --noEmit",
		"lint": "textmode-lint lint .",
		"lint:markdown": "textmode-lint lint:markdown",
		"format": "textmode-lint format",
		"format:check": "textmode-lint format:check",
		"check:boundaries": "node ./scripts/check-boundaries.mjs",
		"check": "npm run format:check && npm run lint && npm run lint:markdown && npm run check:boundaries && npm run typecheck && npm run test && npm run build:chrome && npm run lint:firefox",
		"e2e": "npm run build:e2e:chrome && playwright test",
		"prepare": "textmode-release hooks"
	},
	"prettier": "@textmode/lint/prettier",
	"commitlint": {
		"extends": [
			"@textmode/release/commitlint"
		]
	},
	"dependencies": {
		"textmode.contour.js": "^1.0.1",
		"textmode.export.js": "^1.8.1",
		"textmode.filters.js": "^1.2.5",
		"textmode.js": "^0.18.0",
		"textmode.overlay.js": "^1.0.3"
	},
	"overrides": {
		"esbuild": "0.28.1",
		"shell-quote": "1.8.4",
		"tmp": "0.2.7",
		"uuid": "11.1.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@textmode/build": "^0.1.0",
		"@textmode/lint": "^0.1.1",
		"@textmode/release": "^0.2.1",
		"@types/chrome": "^0.2.7",
		"@types/node": "^26.4.0",
		"globals": "^17.9.0",
		"jsdom": "^30.0.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"web-ext": "^10.5.0",
		"wxt": "^0.21.2"
	}
}
