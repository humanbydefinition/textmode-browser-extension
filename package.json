{
	"name": "textmode-ascii-overlay-extension",
	"version": "1.2.0",
	"description": "Browser extension for overlaying real-time textmode.js ASCII conversion on page canvas and video elements.",
	"type": "module",
	"license": "MIT",
	"author": "humanbydefinition",
	"homepage": "https://code.textmode.art",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/humanbydefinition/textmode-browser-extensions.git"
	},
	"bugs": {
		"url": "https://github.com/humanbydefinition/textmode-browser-extensions/issues"
	},
	"keywords": [
		"ascii-art",
		"browser-extension",
		"chrome-extension",
		"creative-coding",
		"textmode",
		"textmode-js",
		"wxt"
	],
	"engines": {
		"node": ">=20.8.1"
	},
	"scripts": {
		"postinstall": "wxt prepare",
		"build": "wxt build",
		"build:chrome": "wxt build -b chrome --mv3",
		"build:e2e:chrome": "wxt build -b chrome --mv3 --mode e2e",
		"build:opera": "wxt build -b chrome --mv3 --mode opera",
		"build:edge": "wxt build -b edge --mv3",
		"build:firefox": "wxt build -b firefox --mv3",
		"build:safari": "wxt build -b safari",
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox --mv3",
		"zip": "wxt zip",
		"zip:chrome": "wxt zip -b chrome --mv3",
		"zip:opera": "wxt zip -b chrome --mv3 --mode opera && mv .output/textmode-ascii-overlay-extension-$npm_package_version-chrome.zip .output/textmode-ascii-overlay-extension-$npm_package_version-opera.zip",
		"zip:edge": "wxt zip -b edge --mv3",
		"zip:firefox": "wxt zip -b firefox --mv3",
		"lint:firefox": "npm run build:firefox && web-ext lint --source-dir .output/firefox-mv3 --self-hosted",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "prettier --write .",
		"check:format": "prettier --check .",
		"check:boundaries": "node ./scripts/check-boundaries.mjs",
		"check": "npm run check:format && npm run lint && npm run check:boundaries && npm run typecheck && npm run test && npm run build:chrome && npm run lint:firefox",
		"e2e": "npm run build:e2e:chrome && playwright test",
		"prepare": "install-git-hooks"
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
	"prettier": "@textmode/prettier-config",
	"commitlint": {
		"extends": [
			"@textmode/commitlint-config"
		]
	},
	"dependencies": {
		"textmode.contour.js": "^0.1.0",
		"textmode.export.js": "^1.5.2",
		"textmode.filters.js": "^1.2.2",
		"textmode.js": "0.17.0"
	},
	"overrides": {
		"esbuild": "0.28.1",
		"shell-quote": "1.8.4",
		"tmp": "0.2.7",
		"uuid": "11.1.1"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@playwright/test": "^1.61.1",
		"@textmode/commitlint-config": "^0.1.1",
		"@textmode/eslint-config": "^0.1.0",
		"@textmode/prettier-config": "^0.1.0",
		"@textmode/tooling-scripts": "^0.3.4",
		"@types/chrome": "^0.1.34",
		"@types/node": "^26.1.1",
		"eslint": "^9.39.2",
		"globals": "^17.7.0",
		"jsdom": "^29.1.1",
		"lint-staged": "^17.0.8",
		"prettier": "^3.9.4",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.3",
		"vitest": "^4.1.10",
		"web-ext": "^10.4.0",
		"wxt": "^0.20.27"
	}
}
